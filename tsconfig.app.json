{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "../styles/About.tsx", "../styles/AboutArtisticRed.tsx", "../styles/Contact.tsx", "../styles/ContactArtisticRed.tsx", "../styles/Cookies.tsx", "../styles/CookiesArtistic.tsx", "../styles/History.tsx", "../styles/HistoryArtisticRed.tsx", "../styles/Home.tsx", "../styles/HomeArtisticRED.tsx", "../styles/LegalPage.tsx", "../styles/PrivacyPolicyArttisticRed.tsx", "../styles/PrivacyPolicyArtistic.tsx", "../styles/Products.tsx", "../styles/ProductsArtistic.tsx", "../styles/TermsArtistic.tsx", "../styles/TermsArtisticRed.tsx"]
}
